# Server-side URL of the Go extension API.
BACKEND_URL=http://localhost:18888
NEXTAUTH_URL=http://localhost:3000
# Generate a local secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-secret

# Optional paths for a separately implemented search API. The current Go
# extension does not register arbitrary SQL or vector search handlers.
SQL_SEARCH_PATH=
VECTOR_SEARCH_PATH=
