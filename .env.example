# Copy to .env and supply separate random secrets before docker compose up.
POSTGRES_USER=zzfuse
POSTGRES_DB=zzfuse
POSTGRES_PASSWORD=
USER_API_KEY=
ADMIN_API_KEY=
TRAZR_JWT_SECRET=
TRAZR_API_KEY_PEPPER=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
DEFAULT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MAX_MODELS_IN_CACHE=2
GUNICORN_WORKERS=1

# Optional one-time local bootstrap, disabled by default.
TRAZR_BOOTSTRAP_USER=false
TRAZR_BOOTSTRAP_USER_EMAIL=
TRAZR_BOOTSTRAP_USER_PASSWORD=

# Password reset remains unavailable until these settings are configured.
TRAZR_SMTP_HOST=
TRAZR_SMTP_PORT=587
TRAZR_SMTP_USERNAME=
TRAZR_SMTP_PASSWORD=
TRAZR_SMTP_FROM=
TRAZR_SMTP_TLS_MODE=starttls
TRAZR_SMTP_CA_FILE=
TRAZR_SMTP_TIMEOUT=10s
TRAZR_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# OTLP ingestion uses independent random secrets, never account JWTs.
# Generate each secret with: openssl rand -hex 32
TRAZR_INGESTION_TOKEN=
TRAZR_INGESTION_SIGNING_KEY=
TRAZR_INGESTION_SCHEMA=otel
TRAZR_INGESTION_EPOCH=1
